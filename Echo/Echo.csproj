<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ChatAIze.PerfectEmail" Version="0.4.0" />
        <PackageReference Include="JasperFx.RuntimeCompiler" Version="5.0.0" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
        <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="10.0.10" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Common" Version="10.0.10" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.10" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
        <!-- The IDistributedCache the entitlement cache backs onto. Every other service already
             carries this; the gateway did not, because until now it had nothing to cache. -->
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.ServiceDiscovery.Dns" Version="10.8.0" />
        <PackageReference Include="Microsoft.Extensions.ServiceDiscovery.Yarp" Version="10.8.0" />
        <PackageReference Include="Octokit" Version="14.0.0" />
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
        <PackageReference Include="WolverineFx.Postgresql" Version="6.24.6" />
        <PackageReference Include="WolverineFx.RabbitMQ" Version="6.24.6" />
        <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <!-- The bus-backed grant provider and entitlement version provider, plus the change event the
           cache listens for. Contracts only, like Guild.Contracts below: the gateway asks Billing
           over the bus and holds none of its state. -->
      <ProjectReference Include="..\Billing.Contracts\Billing.Contracts.csproj" />
      <ProjectReference Include="..\Echo.Domain\Echo.Domain.csproj" />
      <ProjectReference Include="..\Echo.Entitlements\Echo.Entitlements.csproj" />
      <ProjectReference Include="..\Echo.Infrastructure\Echo.Infrastructure.csproj" />
      <!-- The entitlement endpoints answer for guilds, and membership plus ManageGuild are Guild's
           to say. Contracts only: the gateway asks over the bus like every other caller. -->
      <ProjectReference Include="..\Guild.Contracts\Guild.Contracts.csproj" />
      <ProjectReference Include="..\Identity.Contracts\Identity.Contracts.csproj" />
      <ProjectReference Include="..\Messaging.Infrastructure\Messaging.Infrastructure.csproj" />
      <ProjectReference Include="..\Messaging\Messaging.csproj" />
      <ProjectReference Include="..\Social.Contracts\Social.Contracts.csproj" />
      <ProjectReference Include="..\Echo.Realtime\Echo.Realtime.csproj" />
      <ProjectReference Include="..\Echo.Auth\Echo.Auth.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Echo.Tests asserts that the saga fan-out width never outgrows the retry budget in
             Messaging.SagaConcurrencyRetryDelays; that invariant needs the participant lists. -->
        <InternalsVisibleTo Include="Echo.Tests" />
    </ItemGroup>
</Project>
