<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="10.0.1">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="coverlet.MTP" Version="10.0.1" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.9.0" />
        <PackageReference Include="NSubstitute" Version="6.0.0" />
        <PackageReference Include="NUnit" Version="4.6.1" />
        <PackageReference Include="NUnit.Analyzers" Version="4.14.0">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
        <!-- Runs the behavioural suites a second time against a real Postgres. The InMemory
             provider cannot translate LINQ to SQL, so it cannot catch an untranslatable query -
             see PostgresTestDatabase. -->
        <PackageReference Include="Testcontainers.PostgreSql" Version="4.13.0" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="NUnit.Framework" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Guild.Application\Guild.Application.csproj" />
      <ProjectReference Include="..\Echo.Voice.Testing\Echo.Voice.Testing.csproj" />
    </ItemGroup>

    <!--
      Shared architecture test: fails the build if anything in this assembly compiles to an
      async void method, whose assertions would pass regardless of what they assert. Linked
      into each test project rather than shared through a library, because the only thing worth
      sharing is the failure message and no existing project is referenced by all of them.
    -->
    <ItemGroup>
      <Compile Include="..\TestConventions\AsyncVoidTestConventionTests.cs"
               Link="TestConventions\AsyncVoidTestConventionTests.cs" />
    </ItemGroup>

</Project>
