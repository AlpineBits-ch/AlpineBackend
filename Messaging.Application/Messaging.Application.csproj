<Project Sdk="Microsoft.NET.Sdk.Web">

<PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>
    <PropertyGroup>
        <SixLaborsLicenseFile>./Credentials/sixlabors.lic</SixLaborsLicenseFile>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="AWSSDK.S3" Version="4.0.25.2" />
        <PackageReference Include="dotAPNS.AspNetCore" Version="2.2.2" />
        <PackageReference Include="Facet.Extensions" Version="6.6.8" />
        <PackageReference Include="Facet.Extensions.EFCore" Version="6.6.8" />
        <PackageReference Include="FFMpegCore" Version="5.4.0" />
        <PackageReference Include="FirebaseAdmin" Version="3.5.0" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.9" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="SixLabors.ImageSharp" Version="4.0.0" />
        <PackageReference Include="WolverineFx.EntityFrameworkCore" Version="6.13.1" />
        <PackageReference Include="WolverineFx.Postgresql" Version="6.13.1" />
        <PackageReference Include="WolverineFx.RabbitMQ" Version="6.13.1" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
        <PackageReference Include="WolverineFx.Http" Version="6.13.1" />
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.9" />

    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\AppEnvironment\AppEnvironment.csproj" />
      <ProjectReference Include="..\Guild.Contracts\Guild.Contracts.csproj" />
      <ProjectReference Include="..\Identity.Contracts\Identity.Contracts.csproj" />
      <ProjectReference Include="..\Messaging.Contracts\Messaging.Contracts.csproj" />
      <ProjectReference Include="..\Messaging.Infrastructure\Messaging.Infrastructure.csproj" />
      <ProjectReference Include="..\Messaging\Messaging.csproj" />
      <ProjectReference Include="..\Social.Contracts\Social.Contracts.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Events\" />
    </ItemGroup>

    <ItemGroup>
        <None Include="Credentials\**\*">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup>
        <None Include="Firebase\**\*">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>
</Project>
