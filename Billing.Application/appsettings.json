{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // The tier table from docs/specs/monetization-pricing-model.md section 4, which is a modelled
  // starting position and not a decided price. It is planted in billing_db the first time this
  // service starts against an empty catalogue and is never re-applied afterwards, so everything
  // below is editable from the admin console without a deploy. What stays here is the fallback: an
  // instance with no plan rows resolves entirely from this section, which is what keeps a fresh or
  // self-hosted deployment booting with something sensible.
  //
  // Two things in here are deliberately not from the pricing model and are flagged where they
  // appear: the free user device count, and the guild-side upload ceiling on the user plans.
  //
  // 2160p60 on Pro is what section 4 specifies, and section 7 attaches a hard prerequisite to it:
  // no rung above 1080p should be enabled before server-side layer selection sends preferredRid on
  // the Cloudflare subscribe, because until then every viewer pulls the top layer and a 4K share
  // costs 2.8x what the model says. Lower this rung, or set VOICE_VIDEO_CEILING, until that lands.
  "Entitlements": {
    "DefaultGuildPlan": "free",
    "DefaultUserPlan": "free_user",
    "Plans": {
      "free": {
        "voice.max_participants": "15",
        "voice.video_ceiling": "720p30",
        "voice.max_publishers": "1",
        "storage.upload_max_bytes": "36700160",
        "storage.guild_quota_bytes": "10737418240",
        "guild.audit_log_days": "30",
        "guild.emoji_slots": "100",
        "guild.bots_installed": "5",
        "guild.vanity_url": "false"
      },
      "plus": {
        "voice.max_participants": "35",
        "voice.video_ceiling": "1080p60",
        "voice.max_publishers": "3",
        "storage.upload_max_bytes": "157286400",
        "storage.guild_quota_bytes": "268435456000",
        "guild.audit_log_days": "90",
        "guild.emoji_slots": "300",
        "guild.bots_installed": "15",
        "guild.vanity_url": "false"
      },
      "pro": {
        "voice.max_participants": "75",
        "voice.video_ceiling": "2160p60",
        "voice.max_publishers": "6",
        "storage.upload_max_bytes": "524288000",
        "storage.guild_quota_bytes": "1099511627776",
        "guild.audit_log_days": "365",
        "guild.emoji_slots": "750",
        "guild.bots_installed": "unlimited",
        "guild.vanity_url": "true"
      },

      // The user side. voice.video_ceiling and storage.upload_max_bytes are paired keys, so what a
      // member ends up with is the lower of their plan and their guild's - which is exactly how the
      // pricing model sells the 4K publish right through Venta Plus while the guild's plan still
      // decides what the platform will pay to distribute.
      //
      // user.max_devices on free_user is 5, which the pricing model does not state. It has to be
      // set to something below the paid tier's number: sources merge by taking the more generous
      // value, so leaving it out here would give free accounts the catalogue default of unlimited
      // and make Venta Plus the more restrictive of the two.
      "free_user": {
        "voice.video_ceiling": "1080p30",
        "storage.upload_max_bytes": "36700160",
        "user.upload_max_bytes": "36700160",
        "user.max_devices": "5"
      },
      "venta_plus": {
        "voice.video_ceiling": "2160p60",
        "storage.upload_max_bytes": "157286400",
        "user.upload_max_bytes": "157286400",
        "user.max_devices": "10"
      }
    }
  },

  // What the plans are called and what they cost. Separate from the section above because that one
  // is bound by every service that resolves entitlements and a price is none of their business.
  // Minor units, matching Stripe, so the price object this eventually becomes needs no conversion.
  "Billing": {
    "PlanSeed": {
      "free": {
        "DisplayName": "Free",
        "Description": "A product rather than a demo: full moderation, unlimited history, and voice that works."
      },
      "plus": {
        "DisplayName": "Plus",
        "PriceMinorUnits": 900,
        "Currency": "usd"
      },
      "pro": {
        "DisplayName": "Pro",
        "PriceMinorUnits": 2900,
        "Currency": "usd"
      },
      "free_user": {
        "DisplayName": "Free account"
      },
      "venta_plus": {
        "DisplayName": "Venta Plus",
        "PriceMinorUnits": 600,
        "Currency": "usd"
      }
    }
  }
}
