<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <!-- .NET 10's OpenAPI generator reads XML doc comments, but only if the doc file
             exists. CS1591 is suppressed: these are services, not a published library, so
             demanding a comment on every public member would be noise, not rigour. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JasperFx.RuntimeCompiler" Version="5.0.0" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="10.0.10" />
        <PackageReference Include="WolverineFx" Version="6.24.6" />
        <PackageReference Include="WolverineFx.EntityFrameworkCore" Version="6.24.6" />
        <PackageReference Include="WolverineFx.Http" Version="6.24.6" />
        <PackageReference Include="WolverineFx.Postgresql" Version="6.24.6" />
        <PackageReference Include="WolverineFx.RabbitMQ" Version="6.24.6" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\AppEnvironment\AppEnvironment.csproj" />
      <ProjectReference Include="..\Identity.Contracts\Identity.Contracts.csproj" />
      <ProjectReference Include="..\Import.Contracts\Import.Contracts.csproj" />
      <ProjectReference Include="..\Import.Infrastructure\Import.Infrastructure.csproj" />
      <ProjectReference Include="..\Guild.Contracts\Guild.Contracts.csproj" />
      <!-- Reuses the Gateway envelope/op-code/handshake payload shapes already built for the
           inbound (server) side - the wire protocol is identical, only the connection direction
           (client vs. server) differs. -->
      <ProjectReference Include="..\Bots.Contracts\Bots.Contracts.csproj" />
      <!-- Shared Wolverine configuration (durable inbox/outbox, RabbitMQ, retry policies) -
           same convention every other service (Bots.Application included) already uses. -->
      <ProjectReference Include="..\Messaging\Messaging.csproj" />
    </ItemGroup>

</Project>
