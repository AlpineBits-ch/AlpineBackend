<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- FakeRedisDatabase/FakeRedisBatch stub every StackExchange.Redis member we don't use,
             including its experimental RedisJSON/module surface (SER00x) - none of it is ever called. -->
        <NoWarn>$(NoWarn);SER003;SER006;SER008</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="10.0.1">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
        <PackageReference Include="NSubstitute" Version="6.0.0" />
        <PackageReference Include="NUnit" Version="4.6.1" />
        <PackageReference Include="NUnit.Analyzers" Version="4.14.0">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
        <PackageReference Include="StackExchange.Redis" Version="3.1.3" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="NUnit.Framework"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\IsleBridge.Sdk\IsleBridge.Sdk\IsleBridge.Sdk.csproj" />
      <ProjectReference Include="..\Isle.Application\Isle.Application.csproj" />
      <ProjectReference Include="..\Isle.Domain\Isle.Domain.csproj" />
      <ProjectReference Include="..\Isle.Infrastructure\Isle.Infrastructure.csproj" />
      <ProjectReference Include="..\Isle.Contracts\Isle.Contracts.csproj" />
    </ItemGroup>

    <!--
      Shared architecture test: fails the build if anything in this assembly compiles to an
      async void method, whose assertions would pass regardless of what they assert. Linked
      into each test project rather than shared through a library, because the only thing worth
      sharing is the failure message and no existing project is referenced by all of them.
    -->
    <ItemGroup>
      <Compile Include="..\TestConventions\AsyncVoidTestConventionTests.cs"
               Link="TestConventions\AsyncVoidTestConventionTests.cs" />
    </ItemGroup>

</Project>
