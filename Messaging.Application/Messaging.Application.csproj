<Project Sdk="Microsoft.NET.Sdk.Web">

<PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <!-- .NET 10's OpenAPI generator reads XML doc comments, but only if the doc file
             exists. CS1591 is suppressed: these are services, not a published library, so
             demanding a comment on every public member would be noise, not rigour. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>
    <PropertyGroup>
        <SixLaborsLicenseFile>./Credentials/sixlabors.lic</SixLaborsLicenseFile>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="AWSSDK.S3" Version="4.0.101.7" />
        <PackageReference Include="dotAPNS.AspNetCore" Version="2.2.2" />
        <PackageReference Include="Facet.Extensions" Version="6.6.8" />
        <PackageReference Include="Facet.Extensions.EFCore" Version="6.6.8" />
        <PackageReference Include="FFMpegCore" Version="5.4.0" />
        <PackageReference Include="FirebaseAdmin" Version="3.6.0" />
        <PackageReference Include="JasperFx.RuntimeCompiler" Version="5.0.0" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.10" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="SixLabors.ImageSharp" Version="4.0.0" />
        <PackageReference Include="WolverineFx.EntityFrameworkCore" Version="6.24.6" />
        <PackageReference Include="WolverineFx.Postgresql" Version="6.24.6" />
        <PackageReference Include="WolverineFx.RabbitMQ" Version="6.24.6" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
        <PackageReference Include="WolverineFx.Http" Version="6.24.6" />
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.10" />

    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\AppEnvironment\AppEnvironment.csproj" />
      <!-- Grants, over the bus. Contracts only: the grant table is Billing's and this service reads
           it through the resolver's cache like every other consumer. -->
      <ProjectReference Include="..\Billing.Contracts\Billing.Contracts.csproj" />
      <ProjectReference Include="..\Guild.Contracts\Guild.Contracts.csproj" />
      <!-- Link previews: Messaging decides which links to resolve and who may suppress the result,
           Unfurl answers "what does this URL look like". Contracts only - the fetching itself runs
           in its own service, which is the point (docs/specs/message-previews.md §3). -->
      <ProjectReference Include="..\Unfurl.Contracts\Unfurl.Contracts.csproj" />
      <ProjectReference Include="..\Identity.Contracts\Identity.Contracts.csproj" />
      <ProjectReference Include="..\Messaging.Contracts\Messaging.Contracts.csproj" />
      <ProjectReference Include="..\Messaging.Infrastructure\Messaging.Infrastructure.csproj" />
      <ProjectReference Include="..\Messaging\Messaging.csproj" />
      <ProjectReference Include="..\Social.Contracts\Social.Contracts.csproj" />
      <ProjectReference Include="..\Echo.Realtime\Echo.Realtime.csproj" />
      <ProjectReference Include="..\Federation.Contracts\Federation.Contracts.csproj" />
      <ProjectReference Include="..\Echo.Voice\Echo.Voice.csproj" />
      <ProjectReference Include="..\Echo.Auth\Echo.Auth.csproj" />
      <!-- Storage limits are enforced at the FileService choke point, which needs the resolver in
           process; see docs/specs/monetization.md §4.3 on why this is a library and not a service. -->
      <ProjectReference Include="..\Echo.Entitlements\Echo.Entitlements.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Events\" />
    </ItemGroup>

    <ItemGroup>
        <None Include="Credentials\**\*">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup>
        <None Include="Firebase\**\*">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>
</Project>
