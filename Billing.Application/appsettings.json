{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // The tier table from docs/specs/monetization-pricing-model.md section 4, which is a modelled
  // starting position and not a decided price. It is planted in billing_db the first time this
  // service starts against an empty catalogue and is never re-applied afterwards, so everything
  // below is editable from the admin console without a deploy. What stays here is the fallback: an
  // instance with no plan rows resolves entirely from this section, which is what keeps a fresh or
  // self-hosted deployment booting with something sensible.
  //
  // Three things in here are deliberately not from the pricing model and are flagged where they
  // appear: the free user device count, the guild-side upload ceiling on the user plans, and the
  // message-length ceilings, which come from docs/specs/roleplay-guilds.md section 1.1 instead.
  //
  // 2160p60 on Pro is what section 4 specifies, and section 7 attaches a hard prerequisite to it:
  // no rung above 1080p should be enabled before server-side layer selection sends preferredRid on
  // the Cloudflare subscribe, because until then every viewer pulls the top layer and a 4K share
  // costs 2.8x what the model says. Lower this rung, or set VOICE_VIDEO_CEILING, until that lands.
  "Entitlements": {
    "DefaultGuildPlan": "free",
    "DefaultUserPlan": "free_user",
    "Plans": {
      "free": {
        "voice.max_participants": "15",
        "voice.video_ceiling": "720p30",
        "voice.max_publishers": "1",
        "storage.upload_max_bytes": "36700160",
        "storage.guild_quota_bytes": "10737418240",
        "guild.audit_log_days": "30",
        "guild.emoji_slots": "100",
        "guild.bots_installed": "5",
        "guild.message_max_length": "4000",
        "guild.vanity_url": "false",
        "guild.public_listing": "false",
        "guild.recruitment": "false"
      },
      "plus": {
        "voice.max_participants": "35",
        "voice.video_ceiling": "1080p60",
        "voice.max_publishers": "3",
        "storage.upload_max_bytes": "157286400",
        "storage.guild_quota_bytes": "268435456000",
        "guild.audit_log_days": "90",
        "guild.emoji_slots": "300",
        "guild.bots_installed": "15",
        "guild.message_max_length": "15000",
        "guild.vanity_url": "false",
        "guild.public_listing": "true",
        "guild.recruitment": "true"
      },
      "pro": {
        "voice.max_participants": "75",
        "voice.video_ceiling": "2160p60",
        "voice.max_publishers": "6",
        "storage.upload_max_bytes": "524288000",
        "storage.guild_quota_bytes": "1099511627776",
        "guild.audit_log_days": "365",
        "guild.emoji_slots": "750",
        "guild.bots_installed": "unlimited",
        "guild.message_max_length": "15000",
        "guild.vanity_url": "true",
        "guild.public_listing": "true",
        "guild.recruitment": "true"
      },

      // The user side. voice.video_ceiling and storage.upload_max_bytes are paired keys, so what a
      // member ends up with is the lower of their plan and their guild's - which is exactly how the
      // pricing model sells the 4K publish right through Venta Plus while the guild's plan still
      // decides what the platform will pay to distribute.
      //
      // user.max_devices on free_user is 5, which the pricing model does not state. It has to be
      // set to something below the paid tier's number: sources merge by taking the more generous
      // value, so leaving it out here would give free accounts the catalogue default of unlimited
      // and make Venta Plus the more restrictive of the two. The same applies to
      // user.message_max_length, and to guild.message_max_length on the free plan above.
      "free_user": {
        "voice.video_ceiling": "1080p30",
        "storage.upload_max_bytes": "36700160",
        "user.upload_max_bytes": "36700160",
        "user.message_max_length": "4000",
        "user.max_devices": "5"
      },
      "venta_plus": {
        "voice.video_ceiling": "2160p60",
        "storage.upload_max_bytes": "157286400",
        "user.upload_max_bytes": "157286400",
        "user.message_max_length": "15000",
        "user.max_devices": "10"
      }
    }
  },

  // What the plans are called and what they cost. Separate from the section above because that one
  // is bound by every service that resolves entitlements and a price is none of their business.
  // Minor units, matching Stripe, so the price object this eventually becomes needs no conversion.
  "Billing": {
    "PlanSeed": {
      "free": {
        "DisplayName": "Free",
        "Description": "A product rather than a demo: full moderation, unlimited history, and voice that works."
      },
      "plus": {
        "DisplayName": "Plus",
        "PriceMinorUnits": 900,
        "Currency": "usd"
      },
      "pro": {
        "DisplayName": "Pro",
        "PriceMinorUnits": 2900,
        "Currency": "usd"
      },
      "free_user": {
        "DisplayName": "Free account"
      },
      "venta_plus": {
        "DisplayName": "Venta Plus",
        "PriceMinorUnits": 600,
        "Currency": "usd"
      }
    }
  },

  // What credit can be spent on. Without this section the catalogue is empty, which is a supported
  // state - credit that can be issued and cannot be spent - and it is the state this instance was in:
  // every wallet showed a balance and the client's spend panel showed "there is nothing to spend
  // credits on here just now", because there was not.
  //
  // Point prices are set from the internal peg in CreditOptions.PointsPerEuroPeg, 100 points to the
  // currency unit, against the PlanSeed prices above. That peg is a tool for keeping the two price
  // lists from drifting and is never published as an exchange rate - what the client shows beside the
  // points is the plan's own cash price, read from the plan version rather than computed from here.
  // Change a plan's price in the admin console and this number should move with it; nothing enforces
  // that, because the peg is deliberately not something the service applies on its own.
  //
  // A SKU whose plan carries no cash price is withheld rather than sold (section 8.1), so there is
  // deliberately no SKU for "free" or "free_user" - and adding one would do nothing but put an
  // unbuyable row in the admin catalogue view.
  //
  // Thirty days everywhere because the plans bill monthly and a credit-bought month has to be
  // substitutable for a paid one. Time purchases queue behind whatever the subject already holds of
  // the same plan rather than overlapping it, so buying a month on a guild that is Pro until the 30th
  // starts on the 30th.
  "Credit": {
    "Catalogue": [
      {
        "Code": "guild.plus.30d",
        "Title": "30 days of Plus",
        "Description": "A month of Plus on a server you belong to, starting when its current plan runs out.",
        "PricePoints": 900,
        "Plan": "plus",
        "DurationDays": 30,
        "Subject": "Guild"
      },
      {
        "Code": "guild.pro.30d",
        "Title": "30 days of Pro",
        "Description": "A month of Pro on a server you belong to, starting when its current plan runs out.",
        "PricePoints": 2900,
        "Plan": "pro",
        "DurationDays": 30,
        "Subject": "Guild"
      },
      {
        "Code": "user.venta_plus.30d",
        "Title": "30 days of Venta Plus",
        "Description": "A month of Venta Plus on your own account, starting when your current plan runs out.",
        "PricePoints": 600,
        "Plan": "venta_plus",
        "DurationDays": 30,
        "Subject": "User"
      }
    ]
  }
}
