<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- SubjectKind only. Every consumer of this contract is a service that already resolves
             entitlements, so it already has this reference; sending the subject as a string instead
             would let a publisher and a cache key disagree about capitalisation. -->
        <ProjectReference Include="..\Echo.Entitlements\Echo.Entitlements.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- For Clients/, which is the caller's half of the request contracts here: a bus-backed
             IGrantProvider and IEntitlementVersionProvider, so Guild, Messaging and the gateway do not
             each write their own. Wolverine and the DI abstractions are already carried by every one
             of them, so this adds nothing to what a consumer pulls in. -->
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="WolverineFx" Version="6.24.6" />
    </ItemGroup>

</Project>
