<Project Sdk="Microsoft.NET.Sdk.Web">

<PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="ChatAIze.PerfectEmail" Version="0.4.0" />
      <PackageReference Include="Facet.Extensions" Version="6.6.8" />
      <PackageReference Include="Facet.Extensions.EFCore" Version="6.6.8" />
      <PackageReference Include="FluentValidation" Version="12.1.1" />
      <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
      <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.9" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="OpenIddict.AspNetCore" Version="7.5.0" />
      <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.5.0" />
      <PackageReference Include="OpenIddict.Quartz" Version="7.5.0" />
      <PackageReference Include="OpenIddict.Validation.AspNetCore" Version="7.5.0" />
      <PackageReference Include="RazorLight" Version="2.3.1" />
      <PackageReference Include="WolverineFx.EntityFrameworkCore" Version="6.14.0" />
      <PackageReference Include="WolverineFx.FluentValidation" Version="6.14.0" />
      <PackageReference Include="WolverineFx.Http" Version="6.14.0" />
      <PackageReference Include="WolverineFx.Http.FluentValidation" Version="6.14.0" />
      <PackageReference Include="WolverineFx.Postgresql" Version="6.14.0" />
      <PackageReference Include="WolverineFx.RabbitMQ" Version="6.14.0" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
        <PackageReference Include="WorkOS.net" Version="5.2.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Echo\Echo.csproj" Aliases="EchoApi" />
        <ProjectReference Include="..\Identity.Contracts\Identity.Contracts.csproj" />
      <ProjectReference Include="..\Identity.Infrastructure\Identity.Infrastructure.csproj" />
      <ProjectReference Include="..\Isle.Contracts\Isle.Contracts.csproj" />
      <ProjectReference Include="..\Messaging\Messaging.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Integration\Outbound\" />
    </ItemGroup>
    <PropertyGroup>
        <PreserveCompilationContext>true</PreserveCompilationContext>

        <CopyRefAssembliesToPublishDirectory>true</CopyRefAssembliesToPublishDirectory>
    </PropertyGroup>
    <ItemGroup>
        <None Include="Templates\**\*.cshtml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Include="Certificates\**\*">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>
</Project>
