<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- These are real multi-service, multi-process integration tests (Testcontainers + spawned
         service processes) - too slow/heavy to run implicitly alongside unit tests via a bare
         `dotnet test` on the solution. Run explicitly: dotnet test Echo.E2E.Tests. -->
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.2.0" />
    <PackageReference Include="Testcontainers.RabbitMq" Version="4.2.0" />
    <PackageReference Include="Testcontainers.Redis" Version="4.2.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <!-- Referenced only to force build ordering (guarantees these projects are compiled - and
       their output DLLs available to spawn as real child processes - before the tests run).
       Their types are intentionally never used in-process; see Hosts/SpawnedServiceProcess.cs
       for why each service runs as its own OS process instead of an in-process host. -->
  <ItemGroup>
    <ProjectReference Include="..\Identity.Application\Identity.Application.csproj" />
    <ProjectReference Include="..\Guild.Application\Guild.Application.csproj" />
    <ProjectReference Include="..\Messaging.Application\Messaging.Application.csproj" />
    <ProjectReference Include="..\Social.Application\Social.Application.csproj" />
    <ProjectReference Include="..\Federation.Application\Federation.Application.csproj" />
    <ProjectReference Include="..\Import.Application\Import.Application.csproj" />
    <ProjectReference Include="..\Echo\Echo.csproj" />
  </ItemGroup>

</Project>
