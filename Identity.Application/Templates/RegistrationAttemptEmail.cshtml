@model Identity.Application.Templates.RegistrationAttemptEmail

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Someone tried to sign up with your email address</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background-color: #111318;
            font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
            color: #e2e4ea;
            -webkit-font-smoothing: antialiased;
        }

        .wrapper {
            max-width: 560px;
            margin: 48px auto;
            padding: 0 16px 48px;
        }

        .header {
            padding: 32px 0 24px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo-mark {
            width: 32px;
            height: 32px;
            background: linear-gradient(135deg, #7C5CFC, #5B8DEF);
            border-radius: 8px;
            display: inline-block;
        }

        .logo-text {
            font-size: 15px;
            font-weight: 600;
            color: #ffffff;
            letter-spacing: -0.2px;
        }

        .card {
            background: #1a1d26;
            border: 1px solid #2a2d3a;
            border-radius: 12px;
            overflow: hidden;
        }

        .card-top-bar {
            height: 3px;
            background: linear-gradient(90deg, #F0A93B, #E4693B);
        }

        .card-body {
            padding: 40px 40px 36px;
        }

        .badge {
            display: inline-block;
            background: rgba(240, 169, 59, 0.15);
            color: #f0b45c;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            padding: 4px 10px;
            border-radius: 20px;
            border: 1px solid rgba(240, 169, 59, 0.25);
            margin-bottom: 20px;
        }

        h1 {
            font-size: 24px;
            font-weight: 600;
            color: #ffffff;
            letter-spacing: -0.4px;
            line-height: 1.3;
            margin-bottom: 12px;
        }

        .subtitle {
            font-size: 15px;
            color: #8b8fa8;
            line-height: 1.6;
            margin-bottom: 32px;
        }

        .divider {
            height: 1px;
            background: #2a2d3a;
            margin-bottom: 28px;
        }

        .info-row {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 28px;
        }

        .info-icon {
            width: 36px;
            height: 36px;
            background: #22263a;
            border: 1px solid #2a2d3a;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-size: 16px;
        }

        .info-label {
            font-size: 11px;
            color: #5a5e72;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            font-weight: 500;
            margin-bottom: 2px;
        }

        .info-value {
            font-family: 'DM Mono', 'Cascadia Code', 'Consolas', 'Courier New', monospace;
            font-size: 13px;
            color: #c8cbda;
        }

        ul.actions {
            list-style: none;
            margin-bottom: 28px;
        }

        ul.actions li {
            font-size: 14px;
            color: #c8cbda;
            line-height: 1.7;
            padding-left: 18px;
            position: relative;
        }

        ul.actions li:before {
            content: "";
            position: absolute;
            left: 0;
            top: 10px;
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #7C5CFC;
        }

        .note {
            font-size: 12px;
            color: #454858;
            line-height: 1.6;
        }

        .footer {
            padding: 24px 0 0;
            text-align: center;
            font-size: 12px;
            color: #3a3d50;
            line-height: 1.7;
        }
    </style>
</head>
<body>
    <div class="wrapper">

        <div class="header">
            <span class="logo-mark"></span>
            <span class="logo-text">AlpineBits</span>
        </div>

        <div class="card">
            <div class="card-top-bar"></div>
            <div class="card-body">

                <div class="badge">Sign-up attempt</div>

                <h1>Someone tried to sign up with your email</h1>
                <p class="subtitle">
                    Hi @Model.Name - we received a request to create a new account using this email
                    address. You already have one, so we did not create a second account and nothing
                    about your existing account has changed.
                </p>

                <div class="divider"></div>

                <div class="info-row">
                    <div class="info-icon">✉</div>
                    <div>
                        <div class="info-label">Email</div>
                        <div class="info-value">@Model.Email</div>
                    </div>
                </div>

                <ul class="actions">
                    <li><strong>If this was you:</strong> just sign in with your existing account. If you have forgotten your password, use "Forgot password?" on the sign-in screen.</li>
                    <li><strong>If this was not you:</strong> there is nothing you need to do. No account was created and no one was told whether this address is registered.</li>
                </ul>

                <p class="note">
                    We never include your password or any sign-in code in this message. If you are
                    worried about your account, change your password from the sign-in screen.
                </p>

            </div>
        </div>

        <div class="footer">
            AlpineBits · This email was sent to @Model.Email<br />
            You are receiving this because this address already has an account.
        </div>

    </div>
</body>
</html>
