@model Identity.Application.Templates.RegistrationAttemptEmail

@{
    Layout = null;
}

@* Light, table-based, inline-styled. See WelcomeEmail.cshtml for the rules and
   Messaging/EmailLayout.cs for why they exist.

   Note what this template does NOT interpolate: nothing the sender supplied. Not the username they
   tried, not their IP. The recipient is the account holder, the sender is anonymous and possibly
   hostile, and echoing their text into a mail we send on their behalf would make this a delivery
   channel for whatever they want to write. See RegistrationAttemptEmail.cshtml.cs. *@

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />
    <title>Someone tried to sign up with your email</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f6f8;">

<div style="display:none;max-height:0;overflow:hidden;mso-hide:all;font-size:1px;line-height:1px;color:#f4f6f8;">
    No account was created and nothing about yours has changed.
</div>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f4f6f8" style="background-color:#f4f6f8;">
    <tr>
        <td align="center" style="padding:32px 12px 48px;">
            <table role="presentation" width="560" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:560px;">

                <tr>
                    <td style="padding:0 4px 18px;">
                        <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td style="padding-right:10px;">
                                    <div style="width:26px;height:26px;border-radius:7px;background:#4B5BC4;"></div>
                                </td>
                                <td style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;font-weight:600;color:#14171d;letter-spacing:-.01em;">venta</td>
                            </tr>
                        </table>
                    </td>
                </tr>

                <tr>
                    <td bgcolor="#ffffff" style="background-color:#ffffff;border:1px solid #e3e7ec;border-radius:12px;">
                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td bgcolor="#8a6100" style="background-color:#8a6100;height:3px;line-height:3px;font-size:0;border-radius:12px 12px 0 0;">&nbsp;</td>
                            </tr>
                            <tr>
                                <td style="padding:30px 32px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">

                                    <div style="font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:#8a6100;margin:0 0 12px;">Sign-up attempt</div>

                                    <h1 style="margin:0 0 14px;font-size:22px;line-height:1.3;font-weight:600;color:#14171d;letter-spacing:-.02em;">Someone tried to sign up with your email</h1>

                                    <p style="margin:0 0 20px;font-size:15px;line-height:1.6;color:#5b6472;">
                                        Hi @Model.Name - we received a request to create a new account using this email
                                        address. You already have one, so we did not create a second account and nothing
                                        about your existing account has changed.
                                    </p>

                                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td bgcolor="#eef1f5" style="background-color:#eef1f5;height:1px;line-height:1px;font-size:0;">&nbsp;</td></tr></table>
                                    <div style="height:22px;line-height:22px;font-size:0;">&nbsp;</div>

                                    <div style="margin:0 0 20px;">
                                        <div style="font-size:11px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:#646d79;margin:0 0 3px;">Email</div>
                                        <div style="font-size:14px;line-height:1.5;color:#14171d;">@Model.Email</div>
                                    </div>

                                    <p style="margin:0 0 12px;font-size:15px;line-height:1.6;color:#5b6472;">
                                        <strong style="color:#14171d;">If this was you:</strong> just sign in with your
                                        existing account. If you have forgotten your password, use "Forgot password?"
                                        on the sign-in screen.
                                    </p>

                                    <p style="margin:0 0 22px;font-size:15px;line-height:1.6;color:#5b6472;">
                                        <strong style="color:#14171d;">If this was not you:</strong> there is nothing you
                                        need to do. No account was created and no one was told whether this address is
                                        registered.
                                    </p>

                                    <p style="margin:0;font-size:12.5px;line-height:1.6;color:#646d79;">
                                        We never include your password or any sign-in code in this message. If you are
                                        worried about your account, change your password from the sign-in screen.
                                    </p>

                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>

                <tr>
                    <td style="padding:20px 8px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:1.6;color:#646d79;">
                        Sent to @Model.Email<br />
                        You are receiving this because this address already has an account.
                    </td>
                </tr>

            </table>
        </td>
    </tr>
</table>

</body>
</html>
