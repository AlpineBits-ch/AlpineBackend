<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Social.Api</RootNamespace>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Facet.Extensions" Version="6.6.0" />
        <PackageReference Include="Facet.Extensions.EFCore" Version="6.6.0" />
        <PackageReference Include="Facet.Mapping" Version="6.6.0" />
        <PackageReference Include="FluentValidation" Version="12.1.1" />
        <PackageReference Include="IGDB" Version="6.1.0" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.8" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.8" />
        <PackageReference Include="StackExchange.Redis" Version="2.13.1" />
        <PackageReference Include="WolverineFx" Version="5.39.3" />
        <PackageReference Include="WolverineFx.EntityFrameworkCore" Version="5.39.3" />
        <PackageReference Include="WolverineFx.Http" Version="5.39.3" />
        <PackageReference Include="WolverineFx.Postgresql" Version="5.39.3" />
        <PackageReference Include="WolverineFx.RabbitMQ" Version="5.39.3" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.7" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Common" Version="10.0.8" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.8" />
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.18.0" />
    </ItemGroup>


    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>
    <ItemGroup>
        <None Include="Credentials\**\*">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\Messaging\Messaging.csproj" />
      <ProjectReference Include="..\Social.Contracts\Social.Contracts.csproj" />
      <ProjectReference Include="..\Social.Infrastructure\Social.Infrastructure.csproj" />
    </ItemGroup>

</Project>
