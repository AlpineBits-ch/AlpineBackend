<Project Sdk="Microsoft.NET.Sdk.Web">

<PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <OutputType>Exe</OutputType>
        <!-- .NET 10's OpenAPI generator reads XML doc comments, but only if the doc file
             exists. CS1591 is suppressed: these are services, not a published library, so
             demanding a comment on every public member would be noise, not rigour. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="ChatAIze.PerfectEmail" Version="0.4.0" />
      <PackageReference Include="Facet.Extensions" Version="6.6.8" />
      <PackageReference Include="Facet.Extensions.EFCore" Version="6.6.8" />
      <PackageReference Include="FluentValidation" Version="12.1.1" />
      <PackageReference Include="JasperFx.RuntimeCompiler" Version="5.0.0" />
      <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
      <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.10" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="10.0.10" />
      <PackageReference Include="OpenIddict.AspNetCore" Version="7.6.0" />
      <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.6.0" />
      <PackageReference Include="OpenIddict.Quartz" Version="7.6.0" />
      <PackageReference Include="OpenIddict.Validation.AspNetCore" Version="7.6.0" />
      <PackageReference Include="RazorLight" Version="2.3.1" />
      <PackageReference Include="WolverineFx.EntityFrameworkCore" Version="6.21.0" />
      <PackageReference Include="WolverineFx.FluentValidation" Version="6.21.0" />
      <PackageReference Include="WolverineFx.Http" Version="6.21.0" />
      <PackageReference Include="WolverineFx.Http.FluentValidation" Version="6.21.0" />
      <PackageReference Include="WolverineFx.Postgresql" Version="6.21.0" />
      <PackageReference Include="WolverineFx.RabbitMQ" Version="6.21.0" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
        <PackageReference Include="WorkOS.net" Version="6.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Echo\Echo.csproj" Aliases="EchoApi" />
        <ProjectReference Include="..\Identity.Contracts\Identity.Contracts.csproj" />
      <ProjectReference Include="..\Identity.Infrastructure\Identity.Infrastructure.csproj" />
      <ProjectReference Include="..\Isle.Contracts\Isle.Contracts.csproj" />
      <ProjectReference Include="..\Messaging\Messaging.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Integration\Outbound\" />
    </ItemGroup>
    <PropertyGroup>
        <PreserveCompilationContext>true</PreserveCompilationContext>

        <CopyRefAssembliesToPublishDirectory>true</CopyRefAssembliesToPublishDirectory>
    </PropertyGroup>
    <ItemGroup>
        <None Include="Templates\**\*.cshtml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Include="Certificates\**\*">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!--
      The versioned legal documents (T1-12) live in docs/legal at the repository root, beside the
      spec they implement and where a reviewer expects to find text that needs legal review - not
      buried in a service's source tree. They are copied next to the binary as "legal/" so the
      running service can hash and serve them; LEGAL_DOCUMENTS_PATH overrides the location for a
      deployment that mounts them from outside the image.
    -->
    <ItemGroup>
        <None Include="..\docs\legal\**\*">
            <Link>legal\%(RecursiveDir)%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
</Project>
