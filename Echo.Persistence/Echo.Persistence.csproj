<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <OutputType>Library</OutputType>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Redis" Version="1.2.10" />
        <PackageReference Include="WolverineFx" Version="5.39.1" />
        <PackageReference Include="WolverineFx.Postgresql" Version="5.39.1" />
        <PackageReference Include="WolverineFx.RDBMS" Version="5.39.1" />
    </ItemGroup>

</Project>
